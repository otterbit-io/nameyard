{
  "name": "nameyard",
  "version": "1.0.0",
  "private": true,
  "description": "A business name generator with domain availability checks",
  "type": "module",
  "license": "MIT",
  "author": "otterbit-io",
  "scripts": {
    "build": "npm run build:fonts && npm run build:css",
    "build:css": "tailwindcss -i src/style.css -o dist/assets/css/main.css --minify",
    "build:fonts": "node scripts/copy-fonts.js",
    "watch": "tailwindcss -i src/style.css -o dist/assets/css/main.css --watch",
    "start": "npx --yes serve dist",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "tailwindcss": "^3.4.19"
  }
}
